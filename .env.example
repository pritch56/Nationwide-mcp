# Copy to .env and edit. Never commit .env (it is git-ignored).
# Every variable the code reads is listed here; the README "Configuration" section explains each one.
# Lines starting with "#" are unset and take the default shown.

# --- General -----------------------------------------------------------------
# truelayer (default) | lunchflow | enablebanking | statement
NATIONWIDE_PROVIDER=truelayer
# NATIONWIDE_MAX_RANGE_DAYS=400
# NATIONWIDE_TOKEN_STORE=file
# NATIONWIDE_TOKEN_FILE=~/.nationwide-mcp/tokens.json
# NATIONWIDE_TOKEN_JSON=

# --- Transport (stdio needs none of these) -----------------------------------
# NATIONWIDE_MCP_TRANSPORT=stdio
# NATIONWIDE_MCP_HOST=127.0.0.1
# NATIONWIDE_MCP_PORT=8000
# NATIONWIDE_MCP_PATH=/mcp
# NATIONWIDE_MCP_AUTH_TOKEN=
# NATIONWIDE_MCP_ALLOW_NO_AUTH=
# NATIONWIDE_MCP_ALLOWED_HOSTS=
# NATIONWIDE_MCP_LOG_LEVEL=WARNING

# --- Statement files (NATIONWIDE_PROVIDER=statement) -------------------------
# NATIONWIDE_STATEMENT_DIR=
# NATIONWIDE_STATEMENT_MAX_BYTES=10485760

# --- TrueLayer (NATIONWIDE_PROVIDER=truelayer) -------------------------------
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# TRUELAYER_ENV=live
# TRUELAYER_REDIRECT_URI=http://localhost:3000/callback
# TRUELAYER_PROVIDERS=
# TRUELAYER_TOKEN_ENCODING=json
# TRUELAYER_WINDOW_DAYS=88
# Seed refresh token, read only when the token store is empty. This is a secret.
# NATIONWIDE_TRUELAYER_REFRESH_TOKEN=
# Test hooks: leave unset.
# TRUELAYER_AUTH_BASE=
# TRUELAYER_API_BASE=

# --- Lunch Flow (NATIONWIDE_PROVIDER=lunchflow) ------------------------------
# LUNCHFLOW_API_KEY=
# LUNCHFLOW_INSTITUTION_FILTER=nationwide
# LUNCHFLOW_CONNECTED_ON=
# LUNCHFLOW_CONSENT_DAYS=90
# LUNCHFLOW_INVERT_SIGN=
# Test hook: leave unset.
# LUNCHFLOW_BASE_URL=

# --- Enable Banking (NATIONWIDE_PROVIDER=enablebanking) ----------------------
# ENABLEBANKING_APP_ID=
# ENABLEBANKING_PRIVATE_KEY_FILE=
# ENABLEBANKING_PRIVATE_KEY=
# ENABLEBANKING_REDIRECT_URL=
# ENABLEBANKING_COUNTRY=GB
# ENABLEBANKING_ASPSP_NAME=Nationwide
# ENABLEBANKING_SESSION_ID=
# Test hook: leave unset.
# ENABLEBANKING_BASE_URL=
